# ROM images must never be touched by line-ending conversion.
# Git's own binary detection misses some of them (no NUL byte early in the file).
config/roms/*.rom binary
config/roms/*.bin binary
config/profiles/**/*.cmos binary
config/profiles/**/*.nvram binary
config/boot.$B binary
font.png binary
*.png binary
*.ico binary
*.icns binary
*.ttf binary

# third-party license, kept exactly as it ships with the font
LICENSE_DEJAVU -text

# Linux files built from a Windows checkout, where autocrlf would otherwise give
# them CRLF: bash chokes on the \r, and linuxdeploy reads "Icon=xpeccy-plus\r"
# out of the desktop entry and then cannot find the icon by that name
*.sh text eol=lf
*.desktop text eol=lf

# keyboard layouts: the parser splits a line on tabs and keeps everything up to
# the newline, so a CRLF checkout appends a stray \r to the last key of every
# line (harmless only because findKey() does not know that code)
config/keymaps/*.map text eol=lf
# fuse ships these with LF; keep them that way whatever autocrlf is set to
tools/z80test/tests/* text eol=lf
tools/z80test/LICENSE text eol=lf
